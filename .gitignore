# Python
__pycache__/
*.pyc
.pytest_cache/

# Environments
venv/
.venv/
env/

# Secrets
.env
*.key

# Local tooling
.claude/settings.local.json
.DS_Store

# Generated / data
*.log
*.db
*.zip
output/
data/cache/
screenshots/
.claude/

# PyInstaller build output
build/
dist/
dist.noindex/
*.spec

# Intermediate PNGs for the icon; icon.icns is committed, this is regenerated
# from make_icon.py on every build.
assets/icon.iconset/

# Generated VPN configs. Real key material lives outside the repo entirely
# (~/Library/Application Support/VPN Agent/), but these patterns make sure a
# stray export or installer script can never be committed by accident.
*.conf
*.ovpn
install-*.sh
